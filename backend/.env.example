# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Database Settings
# For local Docker Compose setup:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lenny_assistant
# For external/Supabase/Railway setup:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Model Provider Configuration
# Choose primary LLM provider: 'ollama' (default local) or 'anthropic'
LLM_PROVIDER=ollama

# Active Model Name
# Ollama models: 'llama3.1:8b', 'mistral', 'gemma:7b'
# Anthropic models: 'claude-3-5-sonnet-20241022', 'claude-3-haiku-20240307'
LLM_MODEL=llama3.1:8b

# Ollama Endpoint
OLLAMA_BASE_URL=http://ollama:11434

# Anthropic API Key (Required ONLY if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Server Port Settings
PORT=8000
